    private static double? ActualExpPerHour(RoBotClient.Bot.Behavior.MapOption option) =>
        option.MeasuredSeconds > 0 ? option.MeasuredExp / option.MeasuredSeconds * 3600 : null;

    private static double? ActualExpPerKill(RoBotClient.Bot.Behavior.MapOption option) =>
        option.MeasuredKills > 0 ? option.MeasuredExp / option.MeasuredKills : null;

    private static string Delta(double value, string format) => value.ToString($"+{format};-{format};{format}");

    // Move audit: each move into a map paired with the next move out of it, whose Left side is what that map really gave.
    private const double AuditMinSeconds = 180; // = BotBehavior.MeasureSeconds: less is too noisy to judge
    private sealed record AuditRow(MapMoveAudit Move, MapBreakdown? Outcome);

    private static List<AuditRow> AuditRows(List<MapMoveAudit> moves) => moves.Select((move, i) =>
        new AuditRow(move, i + 1 < moves.Count && string.Equals(moves[i + 1].From, move.To, StringComparison.OrdinalIgnoreCase) ? moves[i + 1].Left : null))
        .Reverse().ToList();

    // Median actual ÷ predicted over moves to estimated (never-measured) maps, and the CandidateRealization that would have
    // made those predictions right. Ratios outside 0.05-5 are dropped: a bot stuck or dying in a loop says nothing about the model.
    private static (int N, double Median, double Suggested, double PaidOff) Calibrate(List<List<MapMoveAudit>> bots)
    {
        var ratios = new List<double>();
        var paid = 0;
        var judged = 0;
        foreach (var bot in bots)
            foreach (var row in AuditRows(bot))
            {
                if (row.Outcome is not { Seconds: >= AuditMinSeconds } outcome) continue;
                if (row.Move.Left is { ExpPerHour: > 0 } left) { judged++; if (outcome.ExpPerHour > left.ExpPerHour) paid++; }
                if (row.Move.Predicted.Measured || row.Move.Predicted.ExpPerHour <= 0) continue;
                var ratio = outcome.ExpPerHour / row.Move.Predicted.ExpPerHour;
                if (ratio is >= 0.05 and <= 5) ratios.Add(ratio * row.Move.Realization / BotBehavior.CandidateRealization);
            }
        if (ratios.Count == 0) return (0, 0, 0, 0);
        ratios.Sort();
        var median = ratios[ratios.Count / 2];
        return (ratios.Count, median, median * BotBehavior.CandidateRealization, judged > 0 ? paid / (double)judged : 0);
    }

    private static string PredVs(double predicted, double? actual) => actual is { } a ? $"{predicted:0.#} → {a:0.#}" : $"{predicted:0.#}";

    // The term whose error cost the most: the rate it would have predicted with only that term right, vs the prediction.
    private static string BiggestMiss(MapBreakdown p, MapBreakdown a)
    {
        var seconds = p.PerKill.Total + p.Other;
        if (seconds <= 0 || p.ExpPerKill <= 0) return "";
        double Time(double predicted, double actual) => seconds / Math.Max(0.1, seconds + actual - predicted);
        var terms = new (string Name, double Effect, double Predicted, double Actual)[]
        {
            ("exp/kill", a.ExpPerKill / p.ExpPerKill, p.ExpPerKill, a.ExpPerKill),
            ("fight", Time(p.PerKill.Fight, a.PerKill.Fight), p.PerKill.Fight, a.PerKill.Fight),
            ("search", Time(p.PerKill.Search, a.PerKill.Search), p.PerKill.Search, a.PerKill.Search),
            ("recover", Time(p.PerKill.Recover, a.PerKill.Recover), p.PerKill.Recover, a.PerKill.Recover),
            ("flee", Time(p.PerKill.Flee, a.PerKill.Flee), p.PerKill.Flee, a.PerKill.Flee),
            ("other", Time(p.Other, a.Other), p.Other, a.Other),
        };
        var worst = terms.MinBy(t => Math.Min(t.Effect, 1 / t.Effect)); // furthest from 1 either way
        return $"{worst.Name} {worst.Predicted:0.#} → {worst.Actual:0.#} (×{worst.Effect:0.00} rate)";
    }

    private string MapLabel(string code) => Db.MapsByCode.TryGetValue(code, out var m) && !string.IsNullOrEmpty(m.Name) ? $"{m.Name} ({code})" : code;

    private static string RunTime(TimeSpan t) => t.TotalHours >= 1 ? $"{(int)t.TotalHours}h {t.Minutes:00}m" : $"{t.Minutes}m {t.Seconds:00}s";

    private string? LootIcon(string name)
    {
        _itemIdByName ??= Db.ItemsById.Values.GroupBy(i => i.Name).ToDictionary(g => g.Key, g => g.First().Id);
        return _itemIdByName.TryGetValue(name, out var id) ? ItemIcon(id) : null;
    }
    private string SkillIcon(CharacterSkill skill) =>
        $"icons/skill_{Uri.EscapeDataString(Db.SkillInfoById.GetValueOrDefault(skill)?.Icon ?? "")}.png";

    private readonly record struct SkillRow(string Name, int Level);
    private readonly record struct SkillAllocRow(CharacterSkill Skill, string Name, int Level, int MaxLevel);
    private readonly record struct InvRow(int BagId, int ItemId, string Name, int Count, bool IsUnique, byte Refine, bool Equipped, bool Equippable);
}
