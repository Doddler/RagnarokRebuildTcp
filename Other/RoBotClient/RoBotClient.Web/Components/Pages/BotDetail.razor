    // Forecast HP lost per fight, against the bot's max HP (the simulator's figure for a lost fight can exceed it).
    private string HpLossText(double hpLoss)
    {
        var maxHp = snapshot?.MaxHp ?? 0;
        if (hpLoss <= 0) return " · expected HP loss: none";
        if (maxHp <= 0) return $" · expected HP loss: {hpLoss:N0}";
        return hpLoss >= maxHp
            ? $" · expected HP loss: {hpLoss:N0}, more than its {maxHp:N0} max HP (dies first)"
            : $" · expected HP loss: {hpLoss:N0} of {maxHp:N0} ({hpLoss / maxHp:P0})";
    }

    // Kills per monster made on one map, across the saved telemetry (a kill belongs to the map of the last MapChange).
    private Dictionary<string, int> KillsOnMap(string map)
    {
        var kills = new Dictionary<string, int>();
        string? current = null;
        foreach (var e in tele?.Snapshot() ?? new List<TelemetryEvent>())
        {
            if (e.Type == TelemetryEventType.MapChange) current = e.Detail;
            else if (e.Type == TelemetryEventType.Kill && e.Detail.Length > 0 && string.Equals(current, map, StringComparison.OrdinalIgnoreCase))
                kills[e.Detail] = kills.GetValueOrDefault(e.Detail) + 1;
        }
        return kills;
    }

