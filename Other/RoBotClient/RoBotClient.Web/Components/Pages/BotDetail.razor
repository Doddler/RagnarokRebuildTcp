    private int[] _targets = new int[6];
    private string _skillOrder = "";
    private int _desiredJob;
    private string _preset = "";
    private bool _presetPicked; // a preset chosen here also replaces the skill script on save

    // Picking a preset fills the fields; nothing changes on the bot until Save build.
    private void PickPreset(ChangeEventArgs e)
    {
        _preset = e.Value?.ToString() ?? "";
        if (BuildPresets.Find(_preset) is not { } p) return;
        _desiredJob = p.JobId;
        _targets = (int[])p.Stats.Clone();
        _skillOrder = p.SkillOrder;
        _presetPicked = true;
        _buildSaved = false;
    }
    private bool _buildLoaded, _buildSaved;
    private int[] Targets => Bots.GetBehaviorConfig(Id)?.StatTargets ?? new int[6];

    // The inputs edit local copies, loaded once, so the 500 ms refresh doesn't overwrite what you're typing.
    private void LoadBuild()
    {
        if (_buildLoaded || Bots.GetBehaviorConfig(Id) is not { } cfg) return;
        _targets = (int[])(cfg.StatTargets ?? new int[6]).Clone();
        _skillOrder = cfg.SkillOrder ?? "";
        _desiredJob = cfg.DesiredJobId;
        _preset = BuildPresets.Find(cfg.BuildName)?.Name ?? "";
        _buildLoaded = true;
    }

    private void SaveBuild()
    {
        if (Bots.GetBehaviorConfig(Id) is not { } cfg) return;
        cfg.StatTargets = _targets.Select(t => Math.Clamp(t, 0, 99)).ToArray();
        cfg.SkillOrder = _skillOrder.Trim();
        cfg.DesiredJobId = _desiredJob;
        if (_presetPicked && BuildPresets.Find(_preset) is { } preset) cfg.SkillScript = preset.SkillScript;
        _presetPicked = false;
        _preset = BuildPresets.Find(cfg.BuildName)?.Name ?? "";
        Bots.SaveConfig(Id);
        _buildSaved = true;
    }

