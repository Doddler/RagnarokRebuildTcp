    // A monster's first sprite frame, cropped from its atlas with CSS and shrunk to fit a badge.
    private RenderFragment MonsterPortrait(string monsterName) => builder =>
    {
        if (Sprites.Get(monsterName) is not { } f)
            return;
        var zoom = Math.Min(1.0, 28.0 / Math.Max(f.Width, f.Height)).ToString(System.Globalization.CultureInfo.InvariantCulture);
        builder.OpenElement(0, "span");
        builder.AddAttribute(1, "class", "d-inline-block align-middle me-1");
        builder.AddAttribute(2, "style",
            $"width:{f.Width}px;height:{f.Height}px;zoom:{zoom};" +
            $"background:url('monster-atlas/{Uri.EscapeDataString(f.AtlasName)}.png') -{f.X}px -{f.Top}px no-repeat");
        builder.CloseElement();
    };

    // Client icon art served by Program.cs (/icons/...); rows hide the <img> when an icon is missing.
    private string ItemIcon(int itemId) => $"icons/{Uri.EscapeDataString(Db.Item(itemId)?.Code ?? "")}.png";

    private const int ExpRateWindowMin = 15;
    private double? ExpPerHour(string characterName) => Bots.Progress?.ExpPerHour(characterName, ExpRateWindowMin);

    // Kills that carry the engage-time forecast, averaged per monster and fight context. A kill's exp is the OwnExp
    // step on its sample (already capped at what total exp really grew).
    private List<(string Monster, string Context, int Fights, double ExpPerAttack, double PredAttacks, double Attacks, double PredSeconds, double Seconds, double PredHp, double Hp)> ForecastVsActual(string characterName)
    {
        var samples = Bots.Progress?.Get(characterName) ?? Array.Empty<RoBotClient.Bot.Manager.ProgressSample>();
        return Enumerable.Range(1, Math.Max(samples.Count - 1, 0))
            .Select(i => (k: samples[i], exp: Math.Max(samples[i].OwnExp - samples[i - 1].OwnExp, 0)))
            .Where(x => x.k.PredSeconds.HasValue && x.k.Monster is { Length: > 0 } && x.k.Attacks > 0 && x.k.TimeToKill.HasValue && x.k.HpLost.HasValue)
            .GroupBy(x => (x.k.Monster!, Context(x.k)))
            .Select(g => (g.Key.Item1, g.Key.Item2, g.Count(),
                g.Sum(x => x.exp) / (double)g.Sum(x => x.k.Attacks!.Value),
                g.Average(x => (double)x.k.PredAttacks!.Value), g.Average(x => (double)x.k.Attacks!.Value),
                g.Average(x => x.k.PredSeconds!.Value), g.Average(x => x.k.TimeToKill!.Value),
                g.Average(x => x.k.PredHpLost!.Value), g.Average(x => (double)x.k.HpLost!.Value)))
            .OrderByDescending(r => r.Item4).ThenBy(r => r.Item1).ToList(); // best exp/attack first
    }

    private static string Context(RoBotClient.Bot.Manager.ProgressSample k) =>
        (k.Party == true ? (k.Healer == true ? "party + healer" : "party") : "solo") + (k.Helped == true ? ", helped" : "");

    private static string Vs(double forecast, double actual) => $"{forecast:0.#} → {actual:0.#}";

    // Loot telemetry is keyed by item name (as GameDatabase.ItemName gives it), so map names back to item ids.
    private static Dictionary<string, int>? _itemIdByName;
    private string? LootIcon(string name)
    {
        _itemIdByName ??= Db.ItemsById.Values.GroupBy(i => i.Name).ToDictionary(g => g.Key, g => g.First().Id);
        return _itemIdByName.TryGetValue(name, out var id) ? ItemIcon(id) : null;
    }
    private string SkillIcon(CharacterSkill skill) =>
        $"icons/skill_{Uri.EscapeDataString(Db.SkillInfoById.GetValueOrDefault(skill)?.Icon ?? "")}.png";

